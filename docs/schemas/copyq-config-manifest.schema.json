{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copyq.local/schemas/copyq-config-manifest.schema.json",
  "title": "CopyQ configuration archive manifest",
  "description": "The only JSON object allowed inside copyq-config.json. Extra keys are invalid. Path safety beyond this schema is enforced by SPEC.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "files"],
  "properties": {
    "format": { "const": "copyq-config" },
    "format_version": { "const": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
